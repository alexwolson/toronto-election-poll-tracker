# Data source resolution (see src/lib/feed-source.ts):
#
# 1. FEED_LOCAL_DIR — server-only. When set, feeds are read from this local
#    directory instead of the network. Use it to build/preview against the
#    certified fixture during development.
FEED_LOCAL_DIR=./fixtures
#
# 2. NEXT_PUBLIC_API_URL — override the feed base URL (e.g. a local server).
#    Ignored when FEED_LOCAL_DIR is set.
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# 3. NEXT_PUBLIC_DATA_REVISION — pin the production GitHub-raw source to a
#    specific commit/branch (default "main"). Ignored when the above are set.
# NEXT_PUBLIC_DATA_REVISION=main
