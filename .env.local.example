# Development feed source resolution (see src/lib/feed-source.ts).
# Production ignores these examples and runs `npm run vercel-build`, which
# downloads checksum-verified GitHub Release feeds into `.release-data`.
#
# FEED_LOCAL_DIR is server-only. Use the committed fixtures for local development.
FEED_LOCAL_DIR=./fixtures
#
# Alternatively, unset FEED_LOCAL_DIR and point development at a local feed
# server. Do not use this override for production deployment.
# NEXT_PUBLIC_API_URL=http://localhost:8000
