      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:4px;background:var(--blue, #274490);padding:12px}.ds-nav-link{display:flex;align-items:center;min-height:44px;padding:10px 12px;color:var(--nav-link,#c9d4f0);border-radius:var(--r-sm,6px);font-family:var(--font-body, \"Hanken Grotesk\", sans-serif);font-size:.94rem;font-weight:600;text-decoration:none;transition:background-color .15s ease,color .15s ease}.ds-nav-link:hover,.ds-nav-link[aria-current=\"page\"]{background:var(--veil,rgba(255,255,255,.10));color:var(--paper, #ffffff)}.ds-nav-link:focus-visible{outline:3px solid var(--paper, #ffffff);outline-offset:2px}@media(prefers-reduced-motion:reduce){:host *{transition-duration:.01ms!important;animation-duration:.01ms!important}.ds-card:hover,.ds-card:focus-visible,.ds-btn:active{transform:none}}"
