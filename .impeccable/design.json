  "components": [
    {
      "name": "Page Hero",
      "kind": "custom",
      "refersTo": "page-hero",
      "description": "Ruled editorial lead with one title and optional description and metadata; no decorative kicker.",
      "html": "<section class=\"ds-page-hero\"><h1>Council races</h1><p class=\"ds-page-hero__dek\">See who is running in each Toronto ward and which contests merit closer attention.</p><p class=\"ds-page-hero__meta\">25 wards · 2026 election</p></section>",
      "css": ".ds-page-hero{padding:2.4rem 0 2.5rem;border-top:2px solid var(--line-strong,#1a1a1a);border-radius:0;background:var(--bg-base,#faf9f6);color:var(--text-strong,#1a1a1a)}.ds-page-hero h1{max-width:52rem;margin:0;font:700 clamp(3rem,7vw,5.25rem)/.93 var(--font-newsreader,Georgia,serif);letter-spacing:-.01em}.ds-page-hero__dek{max-width:68ch;margin:1rem 0 0;font:400 clamp(1.15rem,2.2vw,1.45rem)/1.45 var(--font-newsreader,Georgia,serif)}.ds-page-hero__meta{margin:.9rem 0 0;color:var(--text-soft,#666);font:500 .72rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.02em;text-transform:uppercase}"
    },
    {
      "name": "Masthead Navigation",
      "kind": "nav",
      "refersTo": "masthead-nav",
      "description": "Five-link publication navigation with ruled cells and a route-family active baseline.",
      "html": "<nav class=\"ds-masthead\" aria-label=\"Site navigation\"><a class=\"ds-masthead__link ds-masthead__link--active\" aria-current=\"page\" href=\"#\">Home</a><a class=\"ds-masthead__link\" href=\"#\">Mayor</a><a class=\"ds-masthead__link\" href=\"#\">Council</a><a class=\"ds-masthead__link\" href=\"#\">Trustees</a><a class=\"ds-masthead__link\" href=\"#\">How it works</a></nav>",
      "css": ".ds-masthead{display:flex;justify-content:center;border-top:1px solid var(--line-strong,#1a1a1a);border-bottom:1px solid var(--line-soft,#ccc);background:var(--bg-base,#faf9f6)}.ds-masthead__link{min-width:6.5rem;padding:.62rem 1rem;border-right:1px solid var(--line-inner,#e0ddd8);color:var(--text-mid,#555);font:600 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.06em;text-align:center;text-decoration:none;text-transform:uppercase}.ds-masthead__link:last-child{border-right:0}.ds-masthead__link:hover,.ds-masthead__link:focus-visible{background:var(--bg-hover,#f0ede8);color:var(--text-strong,#1a1a1a)}.ds-masthead__link--active{box-shadow:inset 0 -3px 0 var(--text-strong,#1a1a1a);color:var(--text-strong,#1a1a1a)}.ds-masthead__link:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}@media(max-width:680px){.ds-masthead{display:grid;grid-template-columns:repeat(3,1fr)}.ds-masthead__link{min-width:0;min-height:44px;padding:.6rem .2rem}}"
    },
    {
      "name": "Route Tabs",
      "kind": "nav",
      "refersTo": "route-tab",
      "description": "Full-label route navigation that shares ruled edges and scrolls instead of truncating.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Mayor\"><a class=\"ds-tab ds-tab--active\" aria-current=\"page\" href=\"#\">Candidates</a><a class=\"ds-tab\" href=\"#\">Polls</a></nav>",
      "css": ".ds-tabs{display:flex;overflow-x:auto;border:1px solid var(--line-soft,#ccc);border-left:0;background:var(--bg-base,#faf9f6)}.ds-tab{flex:1 0 auto;min-width:max-content;padding:.65rem 1rem;border-left:1px solid var(--line-soft,#ccc);color:var(--text-mid,#555);font:700 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.04em;text-align:center;text-decoration:none;text-transform:uppercase}.ds-tab:hover,.ds-tab:focus-visible{background:var(--bg-hover,#f0ede8);color:var(--text-strong,#1a1a1a)}.ds-tab--active{box-shadow:inset 0 -3px 0 var(--text-strong,#1a1a1a);color:var(--text-strong,#1a1a1a)}.ds-tab:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}"
    },
    {
      "name": "Race View Switcher",
      "kind": "button",
      "refersTo": "segmented-control",
      "description": "Compact List/Map choice using pressed-state semantics and a black selected cell.",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"Display races as\"><button class=\"ds-segmented__button\" aria-pressed=\"true\">List</button><button class=\"ds-segmented__button\" aria-pressed=\"false\">Map</button></div>",
      "css": ".ds-segmented{display:inline-grid;grid-template-columns:repeat(2,minmax(5rem,1fr));border:1px solid var(--line-strong,#1a1a1a);background:var(--bg-base,#faf9f6)}.ds-segmented__button{min-height:44px;padding:.42rem .9rem;border:0;border-right:1px solid var(--line-strong,#1a1a1a);border-radius:0;background:var(--bg-base,#faf9f6);color:var(--text-mid,#555);font:700 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.06em;text-transform:uppercase}.ds-segmented__button:last-child{border-right:0}.ds-segmented__button:hover{background:var(--bg-hover,#f0ede8)}.ds-segmented__button[aria-pressed=\"true\"]{background:var(--text-strong,#1a1a1a);color:var(--bg-base,#faf9f6)}.ds-segmented__button:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}"
    },
    {
      "name": "Ward Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Square mono search field for narrowing ward records.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field__label\">Find a ward</span><input class=\"ds-field__input\" type=\"search\" placeholder=\"Ward, neighbourhood, or councillor\"></label>",
      "css": ".ds-field{display:grid;gap:.25rem;color:var(--text-mid,#555);font:700 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.06em;text-transform:uppercase}.ds-field__input{min-width:16rem;padding:.4rem .6rem;border:1px solid var(--line-strong,#1a1a1a);border-radius:0;background:var(--bg-base,#faf9f6);color:var(--text-strong,#1a1a1a);font:700 .72rem/1.55 var(--font-ibm-mono,monospace);letter-spacing:normal;text-transform:none}.ds-field__input::placeholder{color:var(--text-ghost,#aaa)}.ds-field__input:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}"
    },
    {
      "name": "Council Attention Tags",
      "kind": "chip",
      "refersTo": "attention-tag-elevated",
      "description": "Square, fully stated status labels whose restrained palette maps to evidence meaning.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-tag--high\">High attention</span><span class=\"ds-tag ds-tag--elevated\">Elevated attention</span><span class=\"ds-tag ds-tag--quiet\">Quiet race</span><span class=\"ds-tag ds-tag--open\">Open seat</span></div>",
      "css": ".ds-tags{display:flex;flex-wrap:wrap;gap:.5rem}.ds-tag{display:inline-block;padding:.15rem .4rem;border-radius:0;font:400 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.04em;text-transform:uppercase}.ds-tag--high{background:var(--vuln-high-bg,#fee2e2);color:var(--vuln-high-fg,#9b1c1c)}.ds-tag--elevated{background:var(--vuln-med-bg,#fef3c7);color:var(--vuln-med-fg,#92400e)}.ds-tag--quiet{background:var(--vuln-low-bg,#dcfce7);color:var(--vuln-low-fg,#166534)}.ds-tag--open{background:var(--vuln-open-bg,#e5e5e5);color:var(--text-mid,#555)}"
    },
    {
      "name": "Ward Race Card",
      "kind": "card",
      "refersTo": "ward-card",
      "description": "Independent civic record with one attention edge, one status tag, and optional evidence.",
      "html": "<a class=\"ds-ward-card\" href=\"#\"><span class=\"ds-ward-card__ward\">Ward 20</span><strong class=\"ds-ward-card__title\">Scarborough Southwest</strong><span class=\"ds-ward-card__person\">Parthi Kandavel</span><span class=\"ds-tag ds-tag--high\">High attention</span><small>Electorate growth exceeded the prior winning margin.</small></a>",
      "css": ".ds-ward-card{display:block;padding:.85rem .95rem 1rem;border:1px solid var(--line-soft,#ccc);border-left:4px solid var(--vuln-high-line,#ef4444);border-radius:0;background:var(--bg-base,#faf9f6);color:var(--text-strong,#1a1a1a);text-decoration:none;transition:background .12s}.ds-ward-card:hover{background:var(--bg-hover,#f0ede8)}.ds-ward-card:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}.ds-ward-card__ward{display:block;color:var(--text-faint,#707070);font:600 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.04em;text-transform:uppercase}.ds-ward-card__title{display:block;margin-top:.3rem;font:600 1.05rem/1.1 var(--font-newsreader,Georgia,serif)}.ds-ward-card__person{display:block;margin-top:.35rem;color:var(--text-mid,#555);font:.78rem/1.5 var(--font-source-sans,Arial,sans-serif)}.ds-ward-card .ds-tag{display:inline-block;margin-top:.65rem;padding:.15rem .4rem;border-radius:0;background:var(--vuln-high-bg,#fee2e2);color:var(--vuln-high-fg,#9b1c1c);font:400 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.04em;text-transform:uppercase}.ds-ward-card small{display:block;margin-top:.55rem;color:var(--text-soft,#666);font:.72rem/1.5 var(--font-source-sans,Arial,sans-serif)}"
    },
    {
      "name": "Trustee Race Card",
      "kind": "card",
      "refersTo": "trustee-card",
      "description": "Joined-grid district record with a structural context inset and compact facts.",
      "html": "<a class=\"ds-trustee-card\" href=\"#\"><strong>Ward 6 · York Centre</strong><span class=\"ds-trustee-tag\">Two incumbents</span><span class=\"ds-trustee-card__facts\">4 candidates</span></a>",
      "css": ".ds-trustee-card{display:grid;gap:.28rem;min-height:7.5rem;padding:.85rem;box-shadow:inset 4px 0 0 var(--trustee-two-line,#58798d);border-right:1px solid var(--line-soft,#ccc);border-bottom:1px solid var(--line-soft,#ccc);border-radius:0;background:var(--bg-base,#faf9f6);color:var(--text-strong,#1a1a1a);text-decoration:none}.ds-trustee-card:hover,.ds-trustee-card:focus-visible{background:var(--bg-hover,#f0ede8)}.ds-trustee-card:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}.ds-trustee-card strong{font:700 1.05rem/1.1 var(--font-newsreader,Georgia,serif)}.ds-trustee-tag{justify-self:start;padding:.15rem .4rem;border:1px solid currentColor;border-radius:0;background:var(--trustee-two-bg,#e4ecef);color:var(--trustee-two-fg,#36586d);font:400 .62rem/1.45 var(--font-ibm-mono,monospace);letter-spacing:.04em;text-transform:uppercase}.ds-trustee-card__facts{align-self:end;color:var(--text-soft,#666);font:400 .62rem/1.45 var(--font-ibm-mono,monospace);text-transform:uppercase}"
    },
    {
      "name": "Candidate History Disclosure",
      "kind": "custom",
      "refersTo": "candidate-disclosure-open",
      "description": "Joined directory record whose expanded state spans the grid and moves to raised paper.",
      "html": "<details class=\"ds-candidate\" open><summary><span><strong>Olivia Chow</strong><small>Incumbent mayor</small></span></summary><div class=\"ds-candidate__body\"><p>2023 mayoral by-election · elected</p><a href=\"#\">Campaign website</a></div></details>",
      "css": ".ds-candidate{border-right:1px solid var(--line-soft,#ccc);border-bottom:1px solid var(--line-soft,#ccc);background:var(--bg-base,#faf9f6);color:var(--text-strong,#1a1a1a)}.ds-candidate summary{position:relative;display:flex;min-height:3.5rem;align-items:center;padding:.7rem .85rem .7rem 2rem;cursor:pointer;list-style:none}.ds-candidate summary::-webkit-details-marker{display:none}.ds-candidate summary::before{position:absolute;left:.85rem;content:'▸';color:var(--text-faint,#707070)}.ds-candidate[open]{background:var(--bg-raised,#f5f2ed)}.ds-candidate[open] summary{border-bottom:1px solid var(--line-soft,#ccc)}.ds-candidate[open] summary::before{content:'▾'}.ds-candidate summary:hover,.ds-candidate summary:focus-visible{background:var(--bg-hover,#f0ede8)}.ds-candidate summary:focus-visible{outline:3px solid var(--focus-ring,#1f5f99);outline-offset:3px}.ds-candidate summary span{display:grid;gap:.2rem}.ds-candidate summary strong{font:600 1rem/1.2 var(--font-source-sans,Arial,sans-serif)}.ds-candidate summary small{color:var(--text-soft,#666);font:500 .62rem/1.4 var(--font-ibm-mono,monospace);letter-spacing:.02em;text-transform:uppercase}.ds-candidate__body{padding:.85rem 1rem 1rem;color:var(--text-mid,#555);font:.78rem/1.5 var(--font-source-sans,Arial,sans-serif)}.ds-candidate__body p{margin:0}.ds-candidate__body a{display:inline-block;margin-top:.75rem;color:var(--text-strong,#1a1a1a);font-weight:700;text-underline-offset:.15em}"
