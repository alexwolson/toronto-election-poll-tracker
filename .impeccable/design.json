      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;font-family:var(--font-body, \"Hanken Grotesk\", sans-serif);font-size:1rem;font-weight:700;padding:13px 24px;border:1px solid transparent;border-radius:var(--r,10px);text-decoration:none;cursor:pointer;transition:background-color .15s ease,border-color .15s ease,transform .1s ease}.ds-btn:focus-visible{outline:3px solid var(--blue, #274490);outline-offset:2px;}.ds-btn:active{transform:translateY(1px)}.ds-primary{background:var(--blue, #274490);color:var(--paper, #ffffff)}.ds-primary:hover{background:var(--blue-dark, #1e3574);color:var(--paper, #ffffff)}@media(prefers-reduced-motion:reduce){:host *{transition-duration:.01ms!important;animation-duration:.01ms!important}.ds-card:hover,.ds-card:focus-visible,.ds-btn:active{transform:none}}"
