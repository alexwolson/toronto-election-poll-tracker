      "name": "Forecast Band Board",
      "kind": "custom",
      "refersTo": "forecast-band-card",
      "description": "Joined neutral forecast cells with one board-level top rule and candidate-specific markers.",
      "html": "<div class=\"ds-band-board\"><article class=\"ds-band-card\"><div class=\"ds-band-card__head\"><span class=\"ds-band-marker ds-band-marker--chow\"></span><strong>Olivia Chow</strong></div><div class=\"ds-band-card__frequency\">Wins about 4 times in 5</div></article><article class=\"ds-band-card\"><div class=\"ds-band-card__head\"><span class=\"ds-band-marker ds-band-marker--bradford\"></span><strong>Brad Bradford</strong></div><div class=\"ds-band-card__frequency\">Wins about 1 time in 5</div></article></div>",
      "css": ".ds-band-board{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));border-top:2px solid var(--line-strong,#1a1a1a);border-left:1px solid var(--line-soft,#ccc);background:var(--bg-base,#faf9f6)}.ds-band-card{min-width:0;padding:1rem 1.1rem 1.15rem;border-right:1px solid var(--line-soft,#ccc);border-bottom:1px solid var(--line-soft,#ccc);border-radius:0;color:var(--text-strong,#1a1a1a)}.ds-band-card__head{display:flex;align-items:center;gap:.5rem;margin-bottom:.55rem}.ds-band-card__head strong{font:600 1.05rem/1.1 var(--font-newsreader,Georgia,serif)}.ds-band-marker{width:.85rem;height:.85rem;flex:none;background:var(--color-disengaged,#c8c4be)}.ds-band-marker--chow{border-radius:999px;background:var(--color-chow,#854a90)}.ds-band-marker--bradford{background:var(--color-bradford,#2e8b57)}.ds-band-card__frequency{font:600 1.55rem/1.1 var(--font-newsreader,Georgia,serif)}"
    }
