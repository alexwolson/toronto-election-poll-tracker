      {
        "name": "status-edge",
        "value": "inset 4px 0 0 var(--status-line)",
        "purpose": "Encodes trustee race context inside a joined grid."
      },
      {
        "name": "map-focus-halo",
        "value": "drop-shadow(0 0 2px var(--text-strong))",
        "purpose": "Keeps the white keyboard-focus stroke legible over adjacent map regions."
      }
    ],
